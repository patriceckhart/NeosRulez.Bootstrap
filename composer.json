{
  "description": "A basic package to start building awesome Neos CMS websites based on Bootstrap v5.",
  "type": "neos-package",
  "name": "neosrulez/bootstrap",
  "require": {
    "neos/neos": "^9.0",
    "neos/nodetypes": "^9.0",
    "shel/neos-colorpicker": "^1.6",
    "twbs/bootstrap": "^5.3"
  },
  "autoload": {
    "psr-4": {
      "NeosRulez\\Bootstrap\\": "Classes/"
    }
  },
  "extra": {
