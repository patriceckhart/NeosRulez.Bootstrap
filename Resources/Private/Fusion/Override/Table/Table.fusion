prototype(NeosRulez.Neos.TableBuilder:Content.Abstract) >
prototype(NeosRulez.Neos.TableBuilder:Content.Abstract) < prototype(NeosRulez.Bootstrap:Component.AbstractContent)

prototype(NeosRulez.Neos.TableBuilder:Table) {

    responsive = ${q(node).property('responsive')}
    accentuation = ${q(node).property('accentuation')}

    renderer >
    renderer = afx`
        <NeosRulez.Neos.TableBuilder:Content.Abstract>
            <div @if.render={props.responsive} class="table-responsive">
                <Neos.Neos:ContentCollection @context.node={node} tagName="table" attributes.class={'table' + (props.accentuation ? (' ' + props.accentuation) : '') + (props.className ? (' ' + props.className) : '')} />
            </div>
            <Neos.Neos:ContentCollection @if.render={!props.responsive} @context.node={node} tagName="table" attributes.class={'table' + (props.accentuation ? (' ' + props.accentuation) : '') + (props.className ? (' ' + props.className) : '')} />
        </NeosRulez.Neos.TableBuilder:Content.Abstract>
    `
}

prototype(NeosRulez.Neos.TableBuilder:TableBody) {

    enableDivider = ${q(node).property('enableDivider')}
    verticalAlignment = ${q(node).property('verticalAlignment')}

    renderer >
    renderer = afx`
        <Neos.Neos:ContentCollection @context.node={node} tagName="tbody" attributes.class={(props.enableDivider ? 'table-group-divider' : '') + (props.className ? (' ' + props.className) : '') + (props.verticalAlignment ? (' ' + props.verticalAlignment) : '')} />
    `
}

prototype(NeosRulez.Neos.TableBuilder:TableRow) {

    verticalAlignment = ${q(node).property('verticalAlignment')}

    renderer >
    renderer = afx`
        <Neos.Neos:ContentCollection @context.node={node} tagName="tr" attributes.class={(props.className ? (' ' + props.className) : '') + (props.verticalAlignment ? (' ' + props.verticalAlignment) : '')} />
    `
}

prototype(NeosRulez.Neos.TableBuilder:TableData) {

    verticalAlignment = ${q(node).property('verticalAlignment')}

    renderer = afx`
        <Neos.Neos:ContentCollection @context.node={node} tagName={props.useTh ? 'th' : 'td'} attributes.colspan={props.colSpan} attributes.class={(props.className ? (' ' + props.className) : '') + (props.verticalAlignment ? (' ' + props.verticalAlignment) : '')} />
    `
}
