prototype(Neos.NodeTypes:Text) < prototype(Neos.Neos:ContentComponent) {
    linkColor = ${(q(node).property('linkColor') ? ('link-' + q(node).property('linkColor')) : false)}
    additionalClass = ${(q(node).property('textColor') ? ('text-' + q(node).property('textColor')) + (this.linkColor ? ' ' + this.linkColor : false) : (this.linkColor ? this.linkColor : false))}

    renderer = afx`
        <NeosRulez.Bootstrap:Component.AbstractContent additionalClass={props.additionalClass} >
            <Neos.Neos:Editable property="text" />
        </NeosRulez.Bootstrap:Component.AbstractContent>
    `
}
